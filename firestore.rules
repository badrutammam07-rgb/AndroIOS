rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Koleksi logs: Menyimpan data verifikasi GPS dan kamera
    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
